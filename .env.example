# Copy to .env and adjust. Never commit the real .env.

# Database passwords used by docker compose (dev defaults apply when unset).
POSTGRES_PASSWORD=postgres_dev
APP_DB_PASSWORD=brisamar_app_dev

# Providers: "fake" works offline and is the default; "litellm" calls a real provider.
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake
LLM_MODEL=gemini/gemini-2.5-flash
EMBEDDING_MODEL=gemini/gemini-embedding-001
GEMINI_API_KEY=

# Evidence gate (cosine similarity). Leave empty to use the provider default
# (fake: 0.15, litellm: 0.6). Recalibrate with `make eval` when switching providers.
MIN_VECTOR_SIMILARITY=

# Tracing: console | otlp | none. For Jaeger: `docker compose --profile tracing up`
# and set OTEL_EXPORTER=otlp, OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
